{
  "name": "intable-qa",
  "version": "1.0.0",
  "description": "Automação Playwright para o módulo InTable — intable.inbot.com.br",
  "scripts": {
    "setup": "npx playwright test --project=setup --reporter=line",
    "test:readonly": "npx playwright test --grep @readonly --reporter=line",
    "test": "npx playwright test --reporter=line",
    "codegen": "npx playwright codegen https://intable.inbot.com.br/",
    "codegen:auth": "npx playwright codegen --load-storage=fixtures/.auth/user.json https://intable.inbot.com.br/",
    "report": "npx playwright show-report evidencias/html"
  }
}
