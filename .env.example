# InTable QA — variáveis de ambiente
# Copiar para .env e preencher com valores reais.
# NUNCA commitar o arquivo .env — ele está no .gitignore.

# ── Autenticação InTable (setup global) ───────────────────────────────────────
# Necessárias quando a sessão em fixtures/.auth/user.json estiver expirada.
USER_EMAIL=
USER_PASSWORD=

# ── Suíte de exportação (@export) ─────────────────────────────────────────────
# Habilita a suíte — sem esta flag Playwright não é invocado.
ENABLE_EXPORT_TESTS=false

# Destinatário esperado do e-mail de exportação.
EXPORT_RECIPIENT=

# ── Validação de e-mail via Microsoft Graph (opcional) ────────────────────────
# Habilita o passo de validação de e-mail no Outlook/Microsoft 365.
# Requer admin consent no tenant — consulte docs/export-tests.md.
EMAIL_VALIDATION_ENABLED=false

# Caixa de correio a ser consultada via Microsoft Graph (deve coincidir com EXPORT_RECIPIENT).
MS_MAILBOX_USER=

# App Registration no Microsoft Entra (Azure AD).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Palavras-chave para filtrar o assunto do e-mail (separadas por vírgula).
# Ajustar conforme o assunto real enviado pelo sistema de exportação.
EXPORT_EMAIL_SUBJECT_KEYWORDS=export,exportação,intable,tabela

# ── Suíte de API Keys (@api-key) ──────────────────────────────────────────────
# Habilita a suíte — sem esta flag Playwright não é invocado.
ENABLE_API_KEY_TESTS=false

# Empresa onde gerenciar as API Keys (default: inbot).
API_KEY_TEST_COMPANY=inbot

# Departamento associado à chave, se o formulário exigir (default: testes).
API_KEY_TEST_DEPARTMENT=testes

# Tabela de massa de teste — incluída no nome da chave para rastreabilidade.
# Exemplo: TesteAut
API_KEY_TEST_TABLE=

# ── URL base (opcional) ───────────────────────────────────────────────────────
# Default já configurado nos scripts: https://intable.inbot.com.br
# BASE_URL=https://intable.inbot.com.br
